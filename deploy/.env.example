AUTH_TOKEN=dev-token-change-me
TURN_SECRET=dev-turn-secret-change-me
TURN_REALM=remote.local
# Browser/agent on the same Windows host: 127.0.0.1 is fine for pathfinding.
# On a real VPS set this to the VPS public IP or hostname.
TURN_HOST=127.0.0.1
TURN_PORT=3478
PUBLIC_STUN_URL=stun:stun.l.google.com:19302
